diff --git a/include/zephyr/sys/iterable_sections.h b/include/zephyr/sys/iterable_sections.h
index 1e34749eff4..9575b5c6f21 100644
--- a/include/zephyr/sys/iterable_sections.h
+++ b/include/zephyr/sys/iterable_sections.h
@@ -47,9 +47,23 @@ extern "C" {
  * @param[in]  secname type name of iterable section.
  * @param[in]  section_postfix postfix to use in section name
  */
+#ifdef CONFIG_WASM
+/* wasm-ld has no linker script, so nothing sorts these sections by name the
+ * way the ELF scripts' SORT_BY_NAME does, and some lists depend on that order
+ * (zbus groups a channel's observers by it). On wasm the section is named
+ * z_iter_<secname>.<key>, with the same key the ELF name sorts on, and the
+ * module's section generator lays every family out in key order and defines
+ * the list bounds around it. See DESIGN.md D6 in the zephyr-wasm module.
+ */
+#define TYPE_SECTION_ITERABLE(type, varname, secname, section_postfix) \
+	Z_DECL_ALIGN(type) varname \
+	__attribute__((section("z_iter_" #secname "." \
+			       STRINGIFY(_CONCAT(section_postfix, _))))) __used __noasan
+#else
 #define TYPE_SECTION_ITERABLE(type, varname, secname, section_postfix) \
 	Z_DECL_ALIGN(type) varname \
 	__in_section(_##secname, static, _CONCAT(section_postfix, _)) __used __noasan
+#endif
 
 /**
  * @brief iterable section start symbol for a generic type
@@ -60,7 +74,11 @@ extern "C" {
  * would be TYPE_SECTION_START(foobar)
  *
  */
+#ifdef CONFIG_WASM
+#define TYPE_SECTION_START(secname) _CONCAT(__start_z_iter_, secname)
+#else
 #define TYPE_SECTION_START(secname) _CONCAT(_##secname, _list_start)
+#endif
 
 /**
  * @brief iterable section end symbol for a generic type
@@ -70,7 +88,11 @@ extern "C" {
  * @param[in]  secname type name of iterable section.  For 'struct foobar' this
  * would be TYPE_SECTION_START(foobar)
  */
+#ifdef CONFIG_WASM
+#define TYPE_SECTION_END(secname) _CONCAT(__stop_z_iter_, secname)
+#else
 #define TYPE_SECTION_END(secname) _CONCAT(_##secname, _list_end)
+#endif
 
