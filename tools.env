# SPDX-License-Identifier: Apache-2.0
#
# Canonical toolchain paths. Source this before building by hand:
#   source tools.env
#
# The port needs a matched clang and wasm-ld. Homebrew's LLVM 23 no longer
# bundles lld, so on macOS they come from two keg-only formulas that happen to
# be the same version; on Linux one llvm package usually provides both. This
# finds whichever is present rather than assuming either, so the same scripts
# work on a laptop and on a CI runner.
#
# Override by setting WASM_LLVM_HOME and WASM_LLD_HOME before sourcing.

if [ -z "${WASM_LLVM_HOME:-}" ]; then
  for _c in /opt/homebrew/opt/llvm /usr/local/opt/llvm \
            /usr/lib/llvm-20 /usr/lib/llvm-19 /usr/lib/llvm-18 /usr/lib/llvm-17 /usr; do
    if [ -x "$_c/bin/clang" ]; then WASM_LLVM_HOME="$_c"; break; fi
  done
fi

if [ -z "${WASM_LLD_HOME:-}" ]; then
  for _c in /opt/homebrew/opt/lld /usr/local/opt/lld "${WASM_LLVM_HOME:-}" /usr; do
    if [ -n "$_c" ] && [ -x "$_c/bin/wasm-ld" ]; then WASM_LLD_HOME="$_c"; break; fi
  done
fi

if [ -z "${WASM_LLVM_HOME:-}" ] || [ -z "${WASM_LLD_HOME:-}" ]; then
  echo "tools.env: could not find clang and wasm-ld; set WASM_LLVM_HOME and WASM_LLD_HOME" >&2
fi

export WASM_LLVM_HOME WASM_LLD_HOME
PATH="${WASM_LLVM_HOME:-/usr}/bin:${WASM_LLD_HOME:-/usr}/bin:$PATH"
# wasm-opt and wasm-objdump live here on macOS and on PATH already elsewhere.
[ -d /opt/homebrew/bin ] && PATH="/opt/homebrew/bin:$PATH"
export PATH
unset _c
