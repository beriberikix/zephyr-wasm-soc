# Canonical toolchain paths for the arch/wasm port. Source this before
# building by hand: `source tools.env`.
#
# Homebrew LLVM 23 no longer bundles lld, so clang and wasm-ld come from two
# keg-only formulas that happen to be the same version (23.1.1). Both must be
# on PATH: the clang driver spawns wasm-ld by name when it links.
export WASM_LLVM_HOME=/opt/homebrew/opt/llvm
export WASM_LLD_HOME=/opt/homebrew/opt/lld
export PATH="$WASM_LLVM_HOME/bin:$WASM_LLD_HOME/bin:/opt/homebrew/bin:$PATH"
