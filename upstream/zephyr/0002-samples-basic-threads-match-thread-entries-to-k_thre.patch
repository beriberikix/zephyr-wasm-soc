From 9ef8a28fb4cf72f9945f95d8df1e9db7d6e6dc89 Mon Sep 17 00:00:00 2001
From: Jonathan Beri <jmberi@gmail.com>
Date: Sat, 26 Sep 2026 18:46:47 +0000
Subject: [PATCH 2/6] samples: basic: threads: match thread entries to
 k_thread_entry_t

blink0(), blink1() and uart_out() are declared void f(void) and passed to
K_THREAD_DEFINE(), which casts them to k_thread_entry_t and calls them with
three arguments. Calling a function through an incompatible function type
is undefined behaviour. It works on most targets, but traps on those that
check indirect calls, such as WebAssembly or a CFI-enabled build.

Give the entries the signature k_thread_entry_t declares.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01APoUNc1caCDU2PVRFEQRyi
---
 samples/basic/threads/src/main.c | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/samples/basic/threads/src/main.c b/samples/basic/threads/src/main.c
index 529df15908a..268bff5a7e0 100644
--- a/samples/basic/threads/src/main.c
+++ b/samples/basic/threads/src/main.c
@@ -87,18 +87,30 @@ void blink(const struct led *led, uint32_t sleep_ms, uint32_t id)
 	}
 }
 
-void blink0(void)
+void blink0(void *p1, void *p2, void *p3)
 {
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
 	blink(&led0, 100, 0);
 }
 
-void blink1(void)
+void blink1(void *p1, void *p2, void *p3)
 {
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
 	blink(&led1, 1000, 1);
 }
 
-void uart_out(void)
+void uart_out(void *p1, void *p2, void *p3)
 {
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
 	while (1) {
 		struct printk_data_t *rx_data = k_fifo_get(&printk_fifo,
 							   K_FOREVER);
