From 2a733f610dfa24d7290f9b24ba6ef86982ebd3ad Mon Sep 17 00:00:00 2001
From: Jonathan Beri <jmberi@gmail.com>
Date: Sat, 26 Sep 2026 18:46:48 +0000
Subject: [PATCH 6/6] tests: kernel: pending: match thread entries to
 k_thread_entry_t

task_high() and task_low() are declared void f(void) and passed to
K_THREAD_DEFINE(), which casts them to k_thread_entry_t and calls them
with three arguments. Calling a function through an incompatible function
type is undefined behaviour, and it traps on targets that check indirect
calls.

Give the entries the signature k_thread_entry_t declares.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01APoUNc1caCDU2PVRFEQRyi
---
 tests/kernel/pending/src/main.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/tests/kernel/pending/src/main.c b/tests/kernel/pending/src/main.c
index b962d10b59d..b55c6797e99 100644
--- a/tests/kernel/pending/src/main.c
+++ b/tests/kernel/pending/src/main.c
@@ -234,8 +234,12 @@ static void coop_low(void *arg1, void *arg2, void *arg3)
 	lifo_tests(HALF_SECOND, &coop_low_state, my_lifo_get, k_sem_take);
 }
 
-void task_high(void)
+void task_high(void *p1, void *p2, void *p3)
 {
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
 	k_fifo_init(&fifo);
 	k_lifo_init(&lifo);
 
@@ -270,8 +274,12 @@ void task_high(void)
 	timer_tests();
 }
 
-void task_low(void)
+void task_low(void *p1, void *p2, void *p3)
 {
+	ARG_UNUSED(p1);
+	ARG_UNUSED(p2);
+	ARG_UNUSED(p3);
+
 	fifo_tests(FOURTH_SECOND, &task_low_state, my_fifo_get, k_sem_take);
 
 	lifo_tests(FOURTH_SECOND, &task_low_state, my_lifo_get, k_sem_take);
