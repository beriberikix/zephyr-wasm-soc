config UART_WASM_HOST
	bool "UART over the zephyr_host uart imports"
	default y
	depends on DT_HAS_WASM_HOST_UART_ENABLED
	depends on SERIAL
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	help
	  The host reads and writes a byte at a time. Polled, and with
	  CONFIG_UART_INTERRUPT_DRIVEN interrupt-driven too: the host raises the
	  UART line when bytes arrive, and the driver raises it itself while its
	  transmit interrupt is enabled.
