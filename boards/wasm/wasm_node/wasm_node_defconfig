CONFIG_MINIMAL_LIBC=y
CONFIG_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_DYNAMIC_INTERRUPTS=y
CONFIG_TICKLESS_KERNEL=y

# ELF-shaped build steps that cannot run on a wasm module. Each one is
# recorded in DESIGN.md with its reason.
CONFIG_BUILD_OUTPUT_BIN=n
CONFIG_OUTPUT_STAT=n
CONFIG_OUTPUT_PRINT_MEMORY_USAGE=n
CONFIG_GEN_ISR_TABLES=n
CONFIG_DEVICE_DEPS=n
# Reads the linked ELF's symbol table.
CONFIG_CHECK_INIT_PRIORITIES=n

# Every thread stack object gives ARCH_THREAD_STACK_RESERVED bytes to the
# Asyncify buffer, so the defaults have to clear that reservation with room
# left for an actual stack. See DESIGN.md D8.
CONFIG_MAIN_STACK_SIZE=16384
CONFIG_IDLE_STACK_SIZE=8192
CONFIG_ISR_STACK_SIZE=8192
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=16384
