/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * There is no hardware to describe. The devicetree exists because Zephyr's
 * build requires one, and it names the host-provided devices so drivers can
 * be bound the ordinary way.
 */

/dts-v1/;

#include <mem.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/arch/wasm/wasm_irq_lines.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "WebAssembly on a Node.js host";
	compatible = "wasm,node";
	interrupt-parent = <&host_intc>;

	chosen {
		zephyr,console = &host_uart;
		zephyr,shell-uart = &host_uart;
		zephyr,sram = &ram0;
		zephyr,entropy = &host_rng;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &flashcontroller0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &display0;
		zephyr,touch = &host_input;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		led3 = &led3;
		sw0 = &sw0;
		sw1 = &sw1;
		eeprom-0 = &eeprom0;
		accel0 = &accel0;
		pressure-sensor = &pressure0;
	};

	/*
	 * A board's worth of LEDs and buttons, drawn by the page. The pins are
	 * on the emulated controller below; host/web/index.html mirrors this
	 * numbering and says so.
	 */
	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			label = "LED 0";
		};

		led1: led_1 {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			label = "LED 1";
		};

		led2: led_2 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "LED 2";
		};

		led3: led_3 {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "LED 3";
		};
	};

	/*
	 * Active low with a pull-up, which is how a button is usually wired and
	 * so what the samples expect. The host therefore holds an unpressed
	 * button at 1, and the bridge only forwards changes.
	 */
	buttons {
		compatible = "gpio-keys";

		sw0: button_0 {
			gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 0";
			zephyr,code = <INPUT_KEY_0>;
		};

		sw1: button_1 {
			gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 1";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "wasm,cpu";
			reg = <0>;
		};
	};

	/*
	 * A nominal window into the single wasm linear memory. Nothing places
	 * anything here: wasm-ld lays out the module and the heap follows it.
	 * Zephyr wants a zephyr,sram node, so this is one.
	 */
	ram0: memory@0 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x0 0x1000000>;   /* 16 MB, nominal */
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		host_console: console {
			compatible = "wasm,host-console";
			status = "okay";
		};

		host_uart: uart {
			compatible = "wasm,host-uart";
			status = "okay";
			current-speed = <115200>;
		};

		host_timer: timer {
			compatible = "wasm,host-timer";
			status = "okay";
			interrupts = <WASM_IRQ_TIMER>;
		};

		/*
		 * Not a controller to configure: the host sets a bit in a word
		 * and the guest takes it at its next safepoint. The node exists
		 * so drivers can name their line here rather than in C.
		 */
		host_intc: interrupt-controller {
			compatible = "wasm,host-intc";
			status = "okay";
			interrupt-controller;
			#interrupt-cells = <1>;
		};

		/*
		 * Upstream's emulated GPIO, which already knows about pins,
		 * direction, pull, edges and callbacks. Using it rather than
		 * writing a driver means a learner runs the same GPIO code
		 * every other emulated Zephyr target runs.
		 */
		gpio0: gpio_emul {
			compatible = "zephyr,gpio-emul";
			status = "okay";
			rising-edge;
			falling-edge;
			high-level;
			low-level;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
		};

		/*
		 * Upstream's flash simulator, the same one native_sim uses. Off the
		 * posix arch it keeps the whole device as a static array, which
		 * here is part of linear memory. That is why it is 256 KB and not
		 * native_sim's 2 MB: every step-back snapshot copies linear
		 * memory, and the storage samples need 16 erase blocks, not 512.
		 * The host can restore and save the array between steps; see
		 * DESIGN.md.
		 */
		flashcontroller0: flash-controller@0 {
			compatible = "zephyr,sim-flash";
			reg = <0x0 DT_SIZE_K(256)>;
			#address-cells = <1>;
			#size-cells = <1>;
			erase-value = <0xff>;

			flash0: flash@0 {
				status = "okay";
				compatible = "soc-nv-flash";
				erase-block-size = <4096>;
				write-block-size = <1>;
				reg = <0x0 DT_SIZE_K(256)>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <1>;
					#size-cells = <1>;

					/* Nothing is loaded from here: the image is the
					 * wasm module. It exists because
					 * zephyr,code-partition must name something.
					 */
					slot0_partition: partition@0 {
						label = "image-0";
						reg = <0x0 DT_SIZE_K(192)>;
					};

					storage_partition: partition@30000 {
						label = "storage";
						reg = <0x30000 DT_SIZE_K(64)>;
					};
				};
			};
		};

		/*
		 * A display the host draws: a <canvas> on the page. 320x240 as on
		 * native_sim, but RGB565, which is LVGL's default colour depth,
		 * so its samples run unmodified; and at 150 KB of linear memory it
		 * keeps step-back snapshots affordable.
		 */
		display0: display {
			compatible = "wasm,host-display";
			status = "okay";
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
			width = <320>;
			height = <240>;
		};

		/*
		 * Touch and keys from the page: pressing on the display's canvas
		 * and typing while it has focus. See wasm,host-input.
		 */
		host_input: input {
			compatible = "wasm,host-input";
			status = "okay";
			interrupts = <WASM_IRQ_INPUT>;
		};

		/* LVGL reads its pointer from the same touches. */
		lvgl_pointer: lvgl-pointer {
			compatible = "zephyr,lvgl-pointer-input";
			input = <&host_input>;
		};

		/* Upstream's RAM-backed EEPROM simulator, as on native_sim. */
		eeprom0: eeprom {
			compatible = "zephyr,sim-eeprom";
			status = "okay";
			size = <DT_SIZE_K(32)>;
		};

		host_rng: rng {
			compatible = "wasm,host-entropy";
			status = "okay";
		};

		/*
		 * Upstream's emulated I2C controller, as on native_sim, with two
		 * parts on it that upstream also emulates: the sensor drivers are
		 * the real ones, talking to a bus, and only the chips are software.
		 * The bmi160 is the accelerometer upstream's own LVGL chart sample
		 * puts on native_sim's bus. Neither has an interrupt line, so their
		 * drivers run without triggers.
		 */
		i2c0: i2c@100 {
			compatible = "zephyr,i2c-emul-controller";
			status = "okay";
			/* Nominal, as on native_sim: the binding requires one. */
			reg = <0x100 4>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			#address-cells = <1>;
			#size-cells = <0>;
			#forward-cells = <1>;

			accel0: bmi160@68 {
				compatible = "bosch,bmi160";
				reg = <0x68>;
			};

			pressure0: bmp581@46 {
				compatible = "bosch,bmp581";
				reg = <0x46>;
			};
		};

		/* Lets the host set what the emulated sensors measure. */
		host_sensors: sensor-bridge {
			compatible = "wasm,host-sensor-bridge";
			status = "okay";
			sensors = <&accel0>;
			interrupts = <WASM_IRQ_SENSOR>;
		};

		host_gpio: gpio-bridge {
			compatible = "wasm,host-gpio-bridge";
			status = "okay";
			ports = <&gpio0>;
			interrupts = <WASM_IRQ_GPIO>;
		};
	};
};
